{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Initial Catalog=fcg_catalog;User Id=sa;Password=YourPassword123;Persist Security Info=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
    "MongoConnection": "mongodb://user:pass@mongodb:27017/fcg_catalog?authSource=admin"
  },
  "ElasticsearchSettings": {
    "Uri": "http://elasticsearch:9200",
    "IndexName": "games",
    "Username": "",
    "Password": ""
  },
  "RedisSettings": {
    "ConnectionString": "redis:6379",
    "InstanceName": "fcg-catalog:",
    "DefaultTtlSeconds": 60
  },
  "KafkaSettings": {
    "BootstrapServers": "kafka:29092",
    "ClientId": "fcg-catalog",
    "UseSaslSsl": false,
    "Consumer": {
      "GroupId": "fcg-catalog-consumer-group",
      "EnableAutoCommit": false,
      "SessionTimeoutMs": 10000,
      "AutoOffsetReset": "earliest",
      "MaxPollIntervalMs": 300000
    },
    "Topics": {
      "ConsumerTopics": [
        {
          "TopicName": "user-created",
          "HandlerType": "UserCreatedConsumerHandler",
          "MaxTries": 3,
          "Enabled": true
        },
        {
          "TopicName": "payment-processed",
          "HandlerType": "PaymentProcessedConsumer",
          "MaxTries": 3,
          "Enabled": true
        }
      ],
      "ProducerTopics": {
        "UserCreated": "user-created",
        "order-placed": "order-placed"
      }
    }
  },
  "JwtSettings": {
    "SecretKey": "local-development-jwt-secret-key-for-fcg-fase04-1234567890",
    "Issuer": "FCG-User",
    "Audience": "FCG-Client"
  },
  "Observability": {
    "ServiceName": "FCG.Catalog",
    "OtlpEndpoint": "",
    "OtlpAuthHeader": "",
    "EnableOtlpExporter": false
  },
  "AllowedHosts": "*"
}
