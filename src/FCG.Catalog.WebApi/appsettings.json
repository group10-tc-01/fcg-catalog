{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=fcg_catalog;User Id=sa;Password=YourPassword123**;TrustServerCertificate=True;",
    "MongoConnection": "mongodb+srv://<user>:<pass>@cluster0.abc.mongodb.net/?retryWrites=true&w=majority"
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "fcg-catalog",
    "SaslUsername": "",
    "SaslPassword": "",
    "UseSaslSsl": true,
    "Consumer": {
      "GroupId": "fcg-catalog-consumer-group",
      "EnableAutoCommit": false,
      "SessionTimeoutMs": 10000,
      "AutoOffsetReset": "earliest",
      "MaxPollIntervalMs": 300000
    },
    "Topics": {
      "ConsumerTopics": [
        {
          "TopicName": "user-created",
          "HandlerType": "UserCreatedConsumerHandler",
          "MaxTries": 3,
          "Enabled": true
        },
        {
          "TopicName": "payment-processed",
          "HandlerType": "PaymentProcessedConsumer",
          "MaxTries": 3,
          "Enabled": true
        }
      ],
      "ProducerTopics": {
        "UserCreated": "user-created",
        "order-placed": "order-placed"
      }
    }
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "FCG-User",
    "Audience": "FCG-Client"
  },
  "Observability": {
    "ServiceName": "FCG.Catalog",
    "OtlpEndpoint": "",
    "OtlpAuthHeader": "",
    "EnableOtlpExporter": false
  },
  "AllowedHosts": "*"
}
