{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "MongoConnection": "mongodb://localhost:27017/fcg_catalog_test"
  },
  "ElasticsearchSettings": {
    "Uri": "http://localhost:9200",
    "IndexName": "games",
    "Username": "",
    "Password": ""
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "fcg-catalog",
    "UseSaslSsl": false,
    "Consumer": {
      "GroupId": "fcg-catalog-consumer-group",
      "EnableAutoCommit": false,
      "SessionTimeoutMs": 10000,
      "AutoOffsetReset": "earliest",
      "MaxPollIntervalMs": 300000
    },
    "Topics": {
      "ConsumerTopics": [
        {
          "TopicName": "user-created",
          "HandlerType": "UserCreatedConsumerHandler",
          "MaxTries": 3,
          "Enabled": true
        },
        {
          "TopicName": "payment-processed",
          "HandlerType": "PaymentProcessedConsumer",
          "MaxTries": 3,
          "Enabled": true
        }
      ],
      "ProducerTopics": {
        "UserCreated": "user-created",
        "order-placed": "order-placed"
      }
    }
  },
  "JwtSettings": {
    "SecretKey": "test-jwt-signing-key-with-minimum-length",
    "Issuer": "FCG-User",
    "Audience": "FCG-Client"
  },
  "Observability": {
    "ServiceName": "FCG.Catalog",
    "OtlpEndpoint": "",
    "OtlpAuthHeader": "",
    "EnableOtlpExporter": false
  },
  "AllowedHosts": "*"
}
